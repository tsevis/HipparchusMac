# SwiftPM
.build/
.swiftpm/
Package.resolved

# Xcode. The project is generated from App/project.yml by XcodeGen, so the
# .xcodeproj is an artefact and the .yml is the source.
*.xcodeproj/
*.xcworkspace/
DerivedData/
xcuserdata/
*.xcuserstate

# Vendored GEOS is committed on purpose so a clean clone builds without CMake.
# Only the intermediate build tree is ignored, and that lives under .build/.

# Output from hipparchus-cli runs and manual checks. `--out` takes any directory,
# and a world sheet is not a small one — a single run at export quality leaves a
# 239 MB SVG beside an 86 MB PDF, which is not a thing to notice only in a diff.
/out/
/out-*/
*.png.actual

# Working notes, deliberately local. The brief and the handoffs are how this
# gets built, not what it is; they name paths on one machine, argue with
# themselves, and read as instructions to whoever picks the work up next. The
# README is the document for anyone else.
/docs not to push/
/KICKOFF.md
/HANDOFF.md
/HANDOFF_NEXT.md
/NEXT_SESSION.md
/Hipparchus_Land_and_Sea.md

# Bytecode from importing a build script as a module, which is how the palette
# parity fixture is generated from the one that ships the style packs.
__pycache__/

# macOS
.DS_Store

# Built artefacts: the disk image is made by Scripts/make-dmg.sh.
dist/
